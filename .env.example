# Cheese Stick Dock — 치지직 오픈 API 계정 연동용 환경변수 템플릿입니다.
# 파일 이름을 '.env.example' 에서 '.env' 로 변경하여 사용하세요.

CHZZK_CLIENT_ID=""
CHZZK_CLIENT_SECRET=""

# CORS 허용 오리진 (필수 권장).
# 단일: https://your-app.pages.dev
# 복수(공백 구분): "https://your-app.pages.dev https://staging.example.com"
# 미설정 시 요청 URL의 origin을 자동으로 사용하지만, 보안상 명시적 화이트리스트를 권장합니다.
ALLOWED_ORIGIN=""

# 운영자 전용 일일 사용자 지표 (/admin).
# 본인 치지직 채널 ID(hex). 여러 명은 공백으로 구분.
# 미설정 시 /admin은 로그인해 있어도 403입니다.
ADMIN_CHANNEL_ID=""

# 운영자 인가용 시크릿 (필수). 세션 HMAC 서명에 사용하며 브라우저로 내려보내지 않습니다.
# 임의 고엔트로피 문자열을 Pages Secrets / wrangler secret 으로만 설정하세요.
ADMIN_SECRET=""

# Cloudflare KV 바인딩 (프로덕션):
# 1. Cloudflare 대시보드 → Workers & Pages → KV → namespace 생성
# 2. Pages 프로젝트 → Settings → Functions → KV namespace bindings
#
# 통계 캐시 전용 (필수):
#   Variable name: LIVE_STATUS_CACHE
#
# 세션 저장 전용 (강력 권장 - 분리하지 않으면 캐시/세션이 같은 네임스페이스에 공존):
#   Variable name: SESSION_STORE
#
# 로컬 테스트 명령어:
# npm install -g wrangler
# wrangler pages dev . --kv LIVE_STATUS_CACHE --kv SESSION_STORE
